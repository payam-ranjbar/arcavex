{
  "$defs": {
    "Diagnostic": {
      "description": "A single structured diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DoctorCheck": {
      "description": "One environment probe result in a doctor report.",
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "detail"
      ],
      "title": "DoctorCheck",
      "type": "object"
    },
    "DoctorReport": {
      "description": "The result of ``arcavex doctor``: engine version plus per-probe check rows.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/DoctorCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "response_version": {
          "default": 1,
          "title": "Response Version",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "engine_version",
        "checks"
      ],
      "title": "DoctorReport",
      "type": "object"
    },
    "EngineIdentity": {
      "description": "Release identity for the executable serving a desktop client.",
      "properties": {
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "build_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Commit"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        }
      },
      "required": [
        "engine_version"
      ],
      "title": "EngineIdentity",
      "type": "object"
    },
    "EnginePaths": {
      "description": "Arcavex home and the persistent stores rooted beneath it.",
      "properties": {
        "assets": {
          "title": "Assets",
          "type": "string"
        },
        "cache": {
          "title": "Cache",
          "type": "string"
        },
        "extensions": {
          "title": "Extensions",
          "type": "string"
        },
        "fonts": {
          "title": "Fonts",
          "type": "string"
        },
        "home": {
          "title": "Home",
          "type": "string"
        },
        "styles": {
          "title": "Styles",
          "type": "string"
        },
        "templates": {
          "title": "Templates",
          "type": "string"
        }
      },
      "required": [
        "home",
        "assets",
        "cache",
        "extensions",
        "fonts",
        "styles",
        "templates"
      ],
      "title": "EnginePaths",
      "type": "object"
    },
    "SourceLocation": {
      "description": "A location in an authored source file.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "keypath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypath"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "description": "Versioned startup contract shared by desktop CLI and MCP clients.",
  "properties": {
    "accepted_ir_versions": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Ir Versions",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "doctor": {
      "$ref": "#/$defs/DoctorReport"
    },
    "extension_sdk_version": {
      "title": "Extension Sdk Version",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/EngineIdentity"
    },
    "mcp_contract_version": {
      "title": "Mcp Contract Version",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "paths": {
      "$ref": "#/$defs/EnginePaths"
    },
    "produced_ir_version": {
      "title": "Produced Ir Version",
      "type": "string"
    },
    "response_version": {
      "default": 1,
      "title": "Response Version",
      "type": "integer"
    }
  },
  "required": [
    "ok",
    "identity",
    "mcp_contract_version",
    "accepted_ir_versions",
    "produced_ir_version",
    "extension_sdk_version",
    "capabilities",
    "paths",
    "doctor"
  ],
  "title": "EngineHandshakeReport",
  "type": "object"
}
