              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "index",
        "name"
      ],
      "title": "LayerEffect",
      "type": "object"
    },
    "LayerMask": {
