{
  "$defs": {
    "Diagnostic": {
      "description": "A single structured diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "LayerEffect": {
      "description": "One resolved effect declaration attached to a layer.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "enum": [
                "geometry",
                "color",
                "raster",
                "composite"
