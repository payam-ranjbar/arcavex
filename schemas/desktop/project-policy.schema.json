{
  "$defs": {
    "AutomationPolicy": {
      "additionalProperties": false,
      "description": "Versioned project-local policy for semantic automation and extension execution.",
      "properties": {
        "extensions": {
          "default": "unrestricted",
          "enum": [
            "unrestricted",
            "disabled"
          ],
          "title": "Extensions",
          "type": "string"
        },
        "mode": {
          "default": "unrestricted",
          "enum": [
            "unrestricted",
            "review",
            "read_only"
          ],
          "title": "Mode",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "title": "AutomationPolicy",
      "type": "object"
    },
    "Diagnostic": {
      "description": "A single structured diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "SourceLocation": {
      "description": "A location in an authored source file.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "keypath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypath"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "description": "Current project policy together with the revisions that govern it.",
  "properties": {
    "canonical_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Path"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "policy": {
      "$ref": "#/$defs/AutomationPolicy"
    },
    "project_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Revision"
    },
    "render_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Revision"
    },
    "response_version": {
      "default": 1,
      "title": "Response Version",
      "type": "integer"
    }
  },
  "required": [
    "ok"
  ],
  "title": "ProjectPolicyReport",
  "type": "object"
}
