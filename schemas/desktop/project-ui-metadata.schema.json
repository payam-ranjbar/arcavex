{
  "$defs": {
    "Diagnostic": {
      "description": "A single structured diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "LayerUIMetadata": {
      "additionalProperties": false,
      "description": "Non-rendering editor metadata for one stable authored layer ID.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        }
      },
      "title": "LayerUIMetadata",
      "type": "object"
    },
    "ProjectUIMetadata": {
      "additionalProperties": false,
      "description": "Versioned contents of the optional non-rendering ``project.ui.yaml`` sidecar.",
      "properties": {
        "layers": {
          "additionalProperties": {
            "$ref": "#/$defs/LayerUIMetadata"
          },
          "title": "Layers",
          "type": "object"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "workspace": {
          "$ref": "#/$defs/ProjectWorkspaceState"
        }
      },
      "title": "ProjectUIMetadata",
      "type": "object"
    },
    "ProjectWorkspaceState": {
      "additionalProperties": false,
      "description": "Project-local workspace choices that may travel with the authored project.",
      "properties": {
        "active_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Format"
        },
        "active_locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Locale"
        },
        "layer_tree_mode": {
          "default": "definition",
          "enum": [
            "definition",
            "rendered"
          ],
          "title": "Layer Tree Mode",
          "type": "string"
        },
        "selected_layer_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Layer Ids",
          "type": "array"
        }
      },
      "title": "ProjectWorkspaceState",
      "type": "object"
    },
    "SourceLocation": {
      "description": "A location in an authored source file.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "keypath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypath"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "description": "Current editor metadata together with the revisions that govern it.",
  "properties": {
    "canonical_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Path"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/ProjectUIMetadata"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "project_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Revision"
    },
    "render_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Revision"
    },
    "response_version": {
      "default": 1,
      "title": "Response Version",
      "type": "integer"
    }
  },
  "required": [
    "ok"
  ],
  "title": "ProjectUIMetadataReport",
  "type": "object"
}
