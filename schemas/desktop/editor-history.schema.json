{
  "$defs": {
    "Actor": {
      "additionalProperties": true,
      "description": "Who submitted a mutation.\n\nExtra keys are allowed: an MCP client may carry its own identity fields, and the engine's job\nis to record them in history, not to have anticipated them.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "description": "One applied transaction, as history shows it.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "after_project_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Project Revision",
          "type": "string"
        },
        "before_project_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Project Revision",
          "type": "string"
        },
        "command_id": {
          "format": "uuid4",
          "title": "Command Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "actor",
        "summary",
        "before_project_revision",
        "after_project_revision",
        "created_at"
      ],
      "title": "HistoryEntry",
      "type": "object"
    }
  },
  "description": "The undo/redo state of one project.",
  "properties": {
    "branched_by_external_edit": {
      "default": false,
      "title": "Branched By External Edit",
      "type": "boolean"
    },
    "can_redo": {
      "default": false,
      "title": "Can Redo",
      "type": "boolean"
    },
    "can_undo": {
      "default": false,
      "title": "Can Undo",
      "type": "boolean"
    },
    "canonical_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Path"
    },
    "contract_version": {
      "default": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "diagnostics": {
      "items": {},
      "title": "Diagnostics",
      "type": "array"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "response_version": {
      "default": 1,
      "title": "Response Version",
      "type": "integer"
    }
  },
  "required": [
    "ok"
  ],
  "title": "HistoryReport",
  "type": "object"
}
