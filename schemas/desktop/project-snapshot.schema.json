{
  "$defs": {
    "Diagnostic": {
      "description": "A single structured diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "ProjectSourceFile": {
      "description": "A project input and its resolved source location for conflict diagnostics.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "project_owned": {
          "title": "Project Owned",
          "type": "boolean"
        },
        "resolved_path": {
          "title": "Resolved Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "project",
            "ui",
            "template",
            "data",
            "override",
            "asset"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path",
        "resolved_path",
        "role",
        "project_owned"
      ],
      "title": "ProjectSourceFile",
      "type": "object"
    },
    "ProjectTarget": {
      "description": "One deterministic format and locale combination declared by a project.",
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        }
      },
      "required": [
        "format"
      ],
      "title": "ProjectTarget",
      "type": "object"
    },
    "RevisionManifestEntry": {
      "description": "One normalized file or synthetic projection participating in a revision.",
      "properties": {
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "RevisionManifestEntry",
      "type": "object"
    },
    "SourceLocation": {
      "description": "A location in an authored source file.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "keypath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypath"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "description": "Read-only desktop snapshot with independent project and render revisions.",
  "properties": {
    "canonical_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Path"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "data": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data"
    },
    "default_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "dpi": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dpi"
    },
    "formats": {
      "items": {
        "type": "string"
      },
      "title": "Formats",
      "type": "array"
    },
    "locales": {
      "items": {
        "type": "string"
      },
      "title": "Locales",
      "type": "array"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "project_manifest": {
      "items": {
        "$ref": "#/$defs/RevisionManifestEntry"
      },
      "title": "Project Manifest",
      "type": "array"
    },
    "project_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Revision"
    },
    "render_manifest": {
      "items": {
        "$ref": "#/$defs/RevisionManifestEntry"
      },
      "title": "Render Manifest",
      "type": "array"
    },
    "render_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Revision"
    },
    "response_version": {
      "default": 1,
      "title": "Response Version",
      "type": "integer"
    },
    "source_files": {
      "items": {
        "$ref": "#/$defs/ProjectSourceFile"
      },
      "title": "Source Files",
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "style": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/ProjectTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template"
    }
  },
  "required": [
    "ok"
  ],
  "title": "ProjectSnapshotReport",
  "type": "object"
}
