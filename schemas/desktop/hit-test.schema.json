{
  "$defs": {
    "Diagnostic": {
      "description": "A single structured diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "HitCandidate": {
      "description": "One rendered layer whose paint bounds contain the queried canvas point.",
      "properties": {
        "authored_id": {
          "title": "Authored Id",
          "type": "string"
        },
        "bounds_pt": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds Pt",
          "type": "array"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "editable": {
          "title": "Editable",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "group",
            "text",
            "image",
            "shape",
            "path"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locked": {
          "title": "Locked",
          "type": "boolean"
        },
        "paint_bounds_pt": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Paint Bounds Pt",
          "type": "array"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "authored_id",
        "instance_id",
        "kind",
        "display_name",
        "editable",
        "locked",
        "bounds_pt",
        "paint_bounds_pt"
      ],
      "title": "HitCandidate",
      "type": "object"
    },
    "SourceLocation": {
      "description": "A location in an authored source file.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "keypath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypath"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "description": "Topmost-first geometry hit-test result in canonical canvas point space.",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/HitCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Format"
    },
    "locale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locale"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "point_pt": {
      "default": [
        0.0,
        0.0
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Point Pt",
      "type": "array"
    },
    "point_px": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Point Px"
    },
    "response_version": {
      "default": 1,
      "title": "Response Version",
      "type": "integer"
    }
  },
  "required": [
    "ok"
  ],
  "title": "HitTestReport",
  "type": "object"
}
