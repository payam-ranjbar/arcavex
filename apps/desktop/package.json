{
  "name": "@arcavex/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.21.0"
  },
  "scripts": {
    "contracts:generate": "uv run python ../../scripts/export_desktop_schemas.py && node ../../scripts/generate_desktop_contracts.mjs",
    "contracts:check": "uv run python ../../scripts/export_desktop_schemas.py --check && node ../../scripts/generate_desktop_contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "architecture": "vitest run tests/architecture.test.ts",
    "test:contracts": "node --experimental-strip-types --test src/contracts/generated.test.ts",
    "test": "npm run test:contracts && vitest run",
    "test:coverage": "npm run test:contracts && vitest run --coverage",
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  }
}
